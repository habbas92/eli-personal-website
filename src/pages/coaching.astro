---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import photo from '../assets/photos/coaching-group.jpg';

const specialties = [
  'Strength and conditioning',
  'HIIT and circuit training',
  'Full-body, lower-body, upper-body and core training',
  'Pilates Sculpt',
  'Sculpt & Burn',
  'Hot Pilates',
];
const elements = ['Technique', 'Safety', 'Connection', 'Motivation'];
const forPeople = [
  'Start training with a clear structure.',
  'Build strength.',
  'Develop consistency.',
  'Regain confidence in their body.',
  'Prepare physically for a race.',
  'Complement running, cycling or another sport.',
  'Prepare for challenges such as HYROX or Spartan.',
  'Improve performance while maintaining balance in their life.',
];
const qualifications = [
  { name: 'Nordic Certified Personal Trainer', level: 'EQF Level 4' },
  { name: 'EREPS Registered Personal Trainer', level: 'EQF Level 4' },
  { name: 'Nordic Fitness Instructor', level: 'EQF Level 3' },
  { name: 'TBM Sculpt & Burn Certified', level: '' },
  { name: 'Coaching available in English, Spanish and French', level: 'EN · ES · FR' },
];
---
<Base title="Coaching" description="Group coaching, personal coaching and special events with Eli del Toro. Strength, HIIT, Pilates Sculpt and personalized programming, in person on the French Riviera and online worldwide.">

  <section class="page-hero container">
    <div>
      <p class="eyebrow red">Coaching</p>
      <h1 class="display h-md">Train with purpose.<br /><span class="serif red">Push your limits.</span></h1>
    </div>
    <div class="intro">
      <p class="lead">Whether you are looking for fully personalized coaching or want to create a memorable experience for your studio, community or event, my coaching combines strength, technique, intensity and energy.</p>
      <p class="body">Every session has a purpose: to help you move better, develop your abilities and build confidence while enjoying the process.</p>
    </div>
  </section>

  <nav class="container section-nav" aria-label="Sections">
    <a href="#group" class="eyebrow">Group coaching</a>
    <a href="#personal" class="eyebrow">Personal coaching</a>
    <a href="#qualifications" class="eyebrow">Qualifications</a>
    <a href="#testimonials" class="eyebrow">What my clients say</a>
  </nav>

  <section id="group" class="container group split">
    <div class="group-left">
      <p class="eyebrow red">01 · Group coaching</p>
      <h2 class="display h-xs">Collective energy.<br /><span class="serif red">Individual progress.</span></h2>
      <p class="body">I lead challenging, adaptable group classes where every participant can work at their own level and progress safely.</p>
      <div class="frame group-photo">
        <Image src={photo} alt="Eli kneeling with a kettlebell under red studio light" width={1200} widths={[600, 900, 1200]} sizes="(max-width: 860px) 90vw, 45vw" />
      </div>
    </div>
    <div class="group-right">
      <p class="eyebrow brown">My current specialties include</p>
      <ul class="specialties">
        {specialties.map((s) => (<li><span class="dot"></span>{s}</li>))}
      </ul>
      <p class="body">Every class combines challenge, music and motivation. My priority is to bring the group’s energy together, support every participant and make sure everyone finishes feeling strong, accomplished and proud of what they achieved.</p>
    </div>
  </section>

  <section class="container">
    <div class="one-class">
      <div>
        <h2 class="display h-xs">One class, <span class="serif nude">different possibilities.</span></h2>
        <p class="nude-text">I adapt movements, load, tempo and complexity according to each participant’s experience and abilities.</p>
      </div>
      <div>
        <p class="eyebrow nude">The four essential elements of every class</p>
        <ul class="elements">
          {elements.map((e, i) => (
            <li><span class="eyebrow nude">{String(i + 1).padStart(2, '0')}</span><span class="display el">{e}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="personal" class="personal grain">
    <span class="glow"></span>
    <div class="container split">
      <div class="personal-left">
        <p class="eyebrow nude">02 · Personal coaching</p>
        <h2 class="display h-sm">A plan built <span class="serif nude">around you.</span></h2>
        <p class="body-light">I do not use generic training plans. Your program is designed around your goals, experience, training history, availability, injuries and individual needs.</p>
        <p class="body-light">Coaching is available through individual sessions, monthly packages and personalized online programming.</p>
        <p class="eyebrow nude avail">Available in person on the French Riviera<br />and online worldwide.</p>
        <a href="/contact" class="btn btn-white">Apply for personal coaching <Icons name="arrow" /></a>
      </div>
      <div class="personal-right">
        <p class="eyebrow nude">Personal coaching is for people who want to</p>
        <ul class="rows light">
          {forPeople.map((p, i) => (
            <li class="row"><span class="eyebrow nude">{String(i + 1).padStart(2, '0')}</span><span>{p}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="qualifications" class="container quals split">
    <div>
      <p class="eyebrow red">03 · Qualifications</p>
      <h2 class="display h-xs">Certified, registered, <span class="serif red">trilingual.</span></h2>
    </div>
    <ul class="rows quals-list">
      {qualifications.map((q) => (
        <li class="row qual"><span>{q.name}</span>{q.level && <span class="eyebrow level">{q.level}</span>}</li>
      ))}
    </ul>
  </section>

  <section id="testimonials" class="container testimonials">
    <div>
      <p class="eyebrow red">04 · What my clients say</p>
      <h2 class="display h-xs">In their <span class="serif red">words.</span></h2>
    </div>
    <div class="quotes">
      <blockquote class="quote quote-sand">
        <p class="serif">“Training with Eli has been an excellent experience. From the beginning, she has demonstrated her ability as a coach by preparing every workout according to my goals and consistently following my progress. After several months, the results have been extremely positive. I have improved my fitness, strength and performance, but most importantly, I have learned to train with greater structure and purpose. Her preparation, attention and support make a real difference throughout the process. I completely recommend her.”</p>
        <footer><span class="line"></span>Luis</footer>
      </blockquote>
      <blockquote class="quote quote-nude">
        <p class="serif">“Thanks to Eli’s support, I feel much more energetic and, most importantly, I have seen real changes. She is passionate about what she does, highly professional and approachable, and she has taught me how to find balance while leading a more active and healthy life.”</p>
        <footer><span class="line"></span>Amanda</footer>
      </blockquote>
    </div>
  </section>

  <section class="container">
    <div class="cta">
      <span class="glow"></span>
      <div class="cta-text">
        <h2 class="display h-md">How do you want to push your <span class="serif nude">limits?</span></h2>
        <p class="cta-body">Whether through personal coaching, a group class or a special event, we can find the right way to work together.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-white">Apply for personal coaching <Icons name="arrow" /></a>
        <a href="/contact" class="btn btn-outline-light">Invite Eli to your studio or event <Icons name="arrow" /></a>
      </div>
    </div>
  </section>

</Base>

<style>
  .page-hero { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px; align-items: end; padding-block: clamp(48px, 6vw, 88px) clamp(32px, 4vw, 64px); }
  .page-hero .display { margin-top: 20px; }
  .intro { display: flex; flex-direction: column; gap: 16px; padding-bottom: 8px; }
  @media (max-width: 860px) { .page-hero { grid-template-columns: minmax(0, 1fr); } }

  .section-nav { display: flex; flex-wrap: wrap; gap: 10px; border-block: 1px solid var(--line); padding-block: 18px; }
  .section-nav a { padding: 12px 18px; border-radius: 999px; border: 1.5px solid rgba(30, 26, 25, 0.2); }
  .section-nav a:first-child { background: var(--black); color: var(--white); border-color: var(--black); }

  .group { padding-top: var(--section); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .group-left, .group-right { display: flex; flex-direction: column; gap: 22px; }
  .group-right { gap: 28px; padding-top: 8px; }
  .group-photo { aspect-ratio: 3 / 2; border-radius: var(--radius-md); margin-top: 12px; }
  .group-photo img { object-position: 50% 40%; }
  .specialties { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .specialties li { display: flex; align-items: center; gap: 14px; background: var(--sand); border-radius: 16px; padding: 18px 20px; font-size: 16px; font-weight: 700; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); flex-shrink: 0; }
  @media (max-width: 860px) { .group { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .specialties { grid-template-columns: minmax(0, 1fr); } }

  .one-class { margin-top: clamp(40px, 5vw, 72px); background: var(--black); color: var(--white); border-radius: var(--radius-lg); padding: clamp(32px, 5vw, 72px); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px; align-items: center; }
  .one-class > div { display: flex; flex-direction: column; gap: 18px; }
  .nude-text { color: var(--nude); text-wrap: pretty; }
  .elements { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .elements li { background: var(--wine); border-radius: 18px; padding: 22px 18px; display: flex; flex-direction: column; gap: 10px; }
  .el { font-size: 26px; letter-spacing: -0.02em; }
  @media (max-width: 860px) { .one-class { grid-template-columns: minmax(0, 1fr); } }

  .personal { margin-top: var(--section); background: var(--wine); color: var(--white); padding-block: var(--section); overflow: hidden; }
  .personal .glow { top: -300px; right: -200px; width: 900px; height: 900px; background: radial-gradient(closest-side, var(--red) 0%, rgba(77, 20, 24, 0) 70%); opacity: 0.7; }
  .personal-left, .personal-right { display: flex; flex-direction: column; gap: 22px; }
  .personal-right { gap: 18px; padding-top: 8px; }
  .avail { letter-spacing: 0.14em; line-height: 1.7; }
  .personal .btn { align-self: flex-start; margin-top: 6px; }

  .quals { padding-top: var(--section); grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  .quals .display { margin-top: 16px; }
  @media (max-width: 860px) { .quals { grid-template-columns: minmax(0, 1fr); } }
  .qual { justify-content: space-between; align-items: center; gap: 24px; font-size: 18px; font-weight: 700; padding-block: 22px; }
  .qual .level { width: auto; color: var(--brown); text-align: right; flex-shrink: 0; white-space: nowrap; }
  .qual:last-child .level { color: var(--red); }

  .testimonials { padding-top: var(--section); display: flex; flex-direction: column; gap: clamp(24px, 3vw, 36px); }
  .testimonials .display { margin-top: 16px; }
  .quotes { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px; }
  .quote { margin: 0; display: flex; flex-direction: column; gap: 24px; border-radius: var(--radius-md); padding: clamp(28px, 3vw, 44px); }
  .quote .serif { font-size: clamp(22px, 2.1vw, 30px); line-height: 1.3; text-wrap: pretty; }
  .quote footer { display: flex; align-items: center; gap: 12px; margin-top: auto; font-size: 15px; font-weight: 800; }
  .line { display: inline-block; width: 28px; height: 2px; background: var(--red); }
  .quote-sand { background: var(--sand); }
  .quote-nude { background: var(--nude); }
  @media (max-width: 860px) { .quotes { grid-template-columns: minmax(0, 1fr); } }

  .cta { margin-top: var(--section); background: var(--red); color: var(--white); border-radius: var(--radius-lg); padding: clamp(44px, 6vw, 88px) clamp(24px, 5.5vw, 80px); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 32px; align-items: center; position: relative; overflow: hidden; }
  .cta .glow { bottom: -360px; right: -160px; width: 760px; height: 760px; background: var(--wine); opacity: 0.6; }
  .cta-text, .cta-actions { position: relative; }
  .cta-text { display: flex; flex-direction: column; gap: 22px; }
  .cta-body { color: var(--rose-light); max-width: 600px; font-size: 18px; }
  .cta-actions { display: flex; flex-direction: column; gap: 12px; }
  .cta-actions .btn { justify-content: space-between; white-space: normal; text-align: left; }
  @media (max-width: 860px) { .cta { grid-template-columns: minmax(0, 1fr); } }
</style>
