---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import EmailLink from '../components/EmailLink.astro';
---
<Base title="Contact" description="Get in touch with Eli del Toro for personal coaching, group classes or events. French Riviera, online and international.">

  <section class="container contact-panel">
    <div class="panel grain">
      <span class="glow"></span>
      <div class="panel-text">
        <p class="eyebrow nude">Contact</p>
        <h1 class="display h-lg">Let’s <span class="serif nude">talk.</span></h1>
        <p class="body-light">Whether you’re looking for personal coaching, want to experience one of my classes or would like to invite me to your studio, event or collaboration, I’d love to hear from you.</p>
        <p class="eyebrow nude where">French Riviera · Online · International events<br />English · Français · Español</p>
      </div>
      <div class="tiles">
        <EmailLink class="tile tile-white" subject="Hello Eli">
          <span class="tile-main">
            <Icons name="mail" size={28} />
            <span class="tile-label"><span class="eyebrow brown">Email</span><span class="tile-value">Send me an email</span></span>
          </span>
          <Icons name="arrow" size={20} />
        </EmailLink>
        <a class="tile tile-glass" href="https://www.instagram.com/elideltorov" target="_blank" rel="noopener">
          <span class="tile-main">
            <Icons name="instagram" size={28} />
            <span class="tile-label"><span class="eyebrow nude">Instagram</span><span class="tile-value">@elideltorov</span></span>
          </span>
          <Icons name="arrow" size={20} />
        </a>
        <p class="note">The email button opens your mail app directly.</p>
      </div>
    </div>
  </section>

</Base>

<style is:global>
  .contact-panel .panel { margin-top: clamp(24px, 3vw, 40px); background: var(--wine); color: var(--white); border-radius: var(--radius-lg); padding: clamp(44px, 6.5vw, 96px) clamp(24px, 5.5vw, 80px) clamp(44px, 6vw, 88px); display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 4vw, 64px); align-items: start; overflow: hidden; }
  .contact-panel .panel .glow { top: -300px; right: -200px; width: 900px; height: 900px; background: radial-gradient(closest-side, var(--red) 0%, rgba(77, 20, 24, 0) 70%); opacity: 0.7; }
  .contact-panel .panel-text { display: flex; flex-direction: column; gap: 22px; }
  .contact-panel .panel-text .body-light { max-width: 520px; font-size: 18px; }
  .contact-panel .where { letter-spacing: 0.14em; line-height: 1.7; }
  .contact-panel .tiles { display: flex; flex-direction: column; gap: 14px; }
  .contact-panel .tile { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-radius: 22px; padding: clamp(20px, 2vw, 26px) clamp(20px, 2vw, 28px); min-height: 44px; }
  .contact-panel .tile:hover { opacity: 1; transform: translateY(-1px); }
  .contact-panel .tile-main { display: flex; align-items: center; gap: 18px; }
  .contact-panel .tile-label { display: flex; flex-direction: column; gap: 4px; }
  .contact-panel .tile-value { font-size: clamp(17px, 1.5vw, 20px); font-weight: 800; }
  .contact-panel .tile-white { background: var(--white); color: var(--black); }
  .contact-panel .tile-white svg:first-child { color: var(--red); }
  .contact-panel .tile-glass { background: rgba(255, 255, 255, 0.08); color: var(--white); border: 1px solid var(--line-light); }
  .contact-panel .tile-glass svg:first-child { color: var(--nude); }
  .contact-panel .note { font-size: 14px; color: var(--nude); padding: 8px 4px 0; }
  @media (max-width: 860px) { .contact-panel .panel { grid-template-columns: minmax(0, 1fr); } }
</style>
