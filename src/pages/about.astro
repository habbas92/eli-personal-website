---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import portrait from '../assets/photos/about-portrait.jpg';
import story from '../assets/photos/about-story.jpg';
import riviera from '../assets/photos/about-riviera.jpg';

const sports = ['Volleyball', 'Boxing', 'Strength training', 'Indoor cycling'];
---
<Base title="About" description="Eli del Toro was born in Mexico City, found refuge in sport, moved to France and turned her passion into a coaching career on the French Riviera.">

  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow red">About</p>
      <h1 class="display h-lg">Energy has always been my <span class="serif red">signature.</span></h1>
      <p class="body">When I was little, I came home from school and said:</p>
      <p class="serif quote">“Mom, do you know what? I’m yellow.”</p>
      <p class="body">Even then, yellow represented light, happiness and energy to me. Today, that same energy is what I bring into every space, every connection and every class I lead.</p>
    </div>
    <div class="hero-photo">
      <div class="hero-back"></div>
      <div class="frame hero-frame">
        <Image src={portrait} alt="Eli smiling and flexing on a white bench by the sea" width={1100} widths={[480, 800, 1100]} sizes="(max-width: 860px) 90vw, 40vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="story grain">
    <span class="glow"></span>
    <div class="container split">
      <div class="story-left">
        <p class="eyebrow nude">Mexico City</p>
        <h2 class="display h-sm">Movement shaped <span class="serif nude">my story.</span></h2>
        <div class="frame story-photo">
          <Image src={story} alt="Eli doing a push-up on a kettlebell under red light" width={1200} widths={[600, 900, 1200]} sizes="(max-width: 860px) 90vw, 40vw" />
        </div>
        <ul class="pills">
          {sports.map((s) => (<li class="eyebrow">{s}</li>))}
        </ul>
      </div>
      <div class="story-right">
        <p class="lead">I was born in Mexico City and grew up practicing volleyball, boxing, strength training and indoor cycling.</p>
        <p class="body-light">When I lost my father at 15, sport became my refuge. It gave me structure, strength and a way to keep moving forward.</p>
        <p class="body-light">My relationship with exercise was not always balanced. For years, I focused on how my body looked instead of everything it could do. Over time, I learned to value it for its strength and abilities—for allowing me to complete a HYROX, run races and play three volleyball matches in one day.</p>
        <ul class="tiles">
          <li><span class="display">HYROX</span><span class="eyebrow nude">completed</span></li>
          <li><span class="display">Races</span><span class="eyebrow nude">run</span></li>
          <li><span class="display">3 matches</span><span class="eyebrow nude">in one day</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container again split">
    <div>
      <p class="eyebrow red">France · three years ago</p>
      <h2 class="display h-sm">Starting <span class="serif red">again.</span></h2>
    </div>
    <div class="again-right">
      <p class="body">Before becoming a coach, I studied Business Administration and worked in customer experience and logistics. That experience taught me how to listen, understand people and build genuine relationships.</p>
      <p class="body">Three years ago, I moved to France and had to rebuild my professional life in a different culture and a third language.</p>
      <p class="lead">I chose to turn my passion for sport into a profession.</p>
      <p class="body">Building a career as an immigrant has challenged my confidence and persistence, but it has also taught me that many of our limits are the ones we place upon ourselves.</p>
      <div class="frame riviera-photo">
        <Image src={riviera} alt="Eli laughing in a side plank on a bench above the sea" width={1200} widths={[600, 900, 1200]} sizes="(max-width: 860px) 90vw, 50vw" />
      </div>
    </div>
  </section>

  <section class="container">
    <div class="becoming split">
      <div>
        <p class="eyebrow red">Today</p>
        <h2 class="display h-sm">The coach I am <span class="serif red">becoming.</span></h2>
      </div>
      <div class="becoming-right">
        <p class="body">I bring my energy, music, passion and knowledge into every class. I adapt to the people in front of me without losing who I am.</p>
        <p class="body">My goal is not simply to lead a workout. I want people to understand their bodies, develop strength, enjoy movement and leave feeling capable of more than they believed.</p>
        <p class="body">I continue to learn through every course, every class and every person I coach. I am building an international career with curiosity, humility and persistence.</p>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="closing">
      <span class="glow"></span>
      <h2 class="display h-md">The universe has no limits—<span class="serif nude">and neither do I.</span></h2>
      <a href="/contact" class="btn btn-white">Push your limits with me <Icons name="arrow" /></a>
    </div>
  </section>

</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 4vw, 64px); align-items: center; padding-block: clamp(40px, 6vw, 88px) clamp(48px, 6vw, 96px); }
  .hero-text { display: flex; flex-direction: column; gap: clamp(18px, 2vw, 28px); }
  .hero-text .body { max-width: 600px; }
  .quote { font-size: clamp(28px, 3vw, 44px); line-height: 1.15; padding-left: 24px; border-left: 3px solid var(--red); max-width: 600px; font-style: italic; }
  .hero-photo { position: relative; aspect-ratio: 5 / 6; max-height: 640px; }
  .hero-back { position: absolute; inset: 24px -12px -16px 36px; background: var(--nude); border-radius: 28px; transform: rotate(3deg); }
  .hero-frame { position: absolute; inset: 0 16px 0 0; border-radius: 28px; transform: rotate(-2deg); }
  .hero-frame img { object-position: 50% 25%; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-photo { max-width: 420px; width: 100%; margin-inline: auto; aspect-ratio: 4 / 5; }
  }

  .story { background: var(--wine); color: var(--white); padding-block: var(--section); overflow: hidden; }
  .story .glow { top: -300px; left: -220px; width: 860px; height: 860px; background: radial-gradient(closest-side, var(--red) 0%, rgba(77, 20, 24, 0) 70%); opacity: 0.7; }
  .story-left, .story-right { display: flex; flex-direction: column; gap: 24px; }
  .story-right { gap: 26px; padding-top: 16px; }
  .story-photo { aspect-ratio: 4 / 3; border-radius: var(--radius-md); margin-top: 8px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { padding: 10px 14px; border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 999px; color: var(--rose); }
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
  .tiles li { background: rgba(255, 255, 255, 0.08); border: 1px solid var(--line-light); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .tiles .display { font-size: 22px; letter-spacing: -0.02em; }
  @media (max-width: 600px) { .tiles { grid-template-columns: minmax(0, 1fr); } }

  .again { padding-block: var(--section) 0; }
  .again .display, .becoming .display { margin-top: 20px; }
  .again-right, .becoming-right { display: flex; flex-direction: column; gap: 24px; padding-top: 16px; }
  .riviera-photo { aspect-ratio: 3 / 2; border-radius: var(--radius-md); margin-top: 8px; }

  .becoming { margin-top: var(--section); background: var(--sand); border-radius: var(--radius-lg); padding: clamp(36px, 5.5vw, 88px) clamp(24px, 5.5vw, 80px); }

  .closing { margin-top: 24px; background: var(--red); color: var(--white); border-radius: var(--radius-lg); padding: clamp(56px, 7vw, 96px) clamp(24px, 5.5vw, 80px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 32px; position: relative; overflow: hidden; }
  .closing .glow { top: -360px; left: 50%; margin-left: -400px; width: 800px; height: 800px; background: var(--wine); opacity: 0.55; }
  .closing .display, .closing .btn { position: relative; }
  .closing .display { max-width: 1000px; }
</style>
