---
import EmailLink from './EmailLink.astro';
import { localePath, t, type Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <a href={localePath(locale, '/')} class="eyebrow brand">Eli del Toro <span>·</span> Coach</a>
    <nav class="footer-links" aria-label="Footer">
      <a href={localePath(locale, '/')}>{d.nav.home}</a>
      <a href={localePath(locale, '/coaching')}>{d.nav.coaching}</a>
      <a href={localePath(locale, '/about')}>{d.nav.about}</a>
      <a href={localePath(locale, '/contact')}>{d.nav.contact}</a>
      <a href="https://www.instagram.com/elideltorov" target="_blank" rel="noopener">{d.footer.instagram}</a>
      <EmailLink>{d.footer.email}</EmailLink>
    </nav>
    <p class="meta">{d.footer.meta} · © {year} Eli del Toro</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); margin-top: clamp(40px, 5vw, 72px); }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-block: 32px 48px; }
  .brand { font-size: 13px; }
  .brand span { color: var(--red); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .meta { font-size: 13px; color: var(--brown); }
</style>
