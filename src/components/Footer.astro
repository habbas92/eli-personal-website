---
import EmailLink from './EmailLink.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <a href="/" class="eyebrow brand">Eli del Toro <span>·</span> Coach</a>
    <nav class="footer-links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/coaching">Coaching</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="https://www.instagram.com/elideltorov" target="_blank" rel="noopener">Instagram</a>
      <EmailLink>Email</EmailLink>
    </nav>
    <p class="meta">French Riviera · Online · © {year} Eli del Toro</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); margin-top: clamp(40px, 5vw, 72px); }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-block: 32px 48px; }
  .brand { font-size: 13px; }
  .brand span { color: var(--red); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .meta { font-size: 13px; color: var(--brown); }
</style>
