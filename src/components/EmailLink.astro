---
/**
 * Mail link that never puts the address in the HTML.
 * The address is stored reversed and base64-encoded in a data attribute and
 * turned into a mailto: only when the visitor clicks.
 */
interface Props { class?: string; subject?: string; }
const { class: className = '', subject = '' } = Astro.props;
const address = 'elideltorov@gmail.com';
const encoded = Buffer.from(address.split('').reverse().join(''), 'utf8').toString('base64');
---
<a href="#" class={className} data-em={encoded} data-subject={subject} rel="nofollow"><slot /></a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-em]').forEach((a) => {
    a.addEventListener('click', (event) => {
      event.preventDefault();
      const encoded = a.dataset.em ?? '';
      const address = atob(encoded).split('').reverse().join('');
      const subject = a.dataset.subject ? `?subject=${encodeURIComponent(a.dataset.subject)}` : '';
      window.location.href = `mailto:${address}${subject}`;
    });
  });
</script>
